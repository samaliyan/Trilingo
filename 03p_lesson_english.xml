 checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,312][1036,475]" /><node index="2" text="" resource-id="" class="android.widget.LinearLayout" package="io.github.samaliyan.trilingo" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,514][1036,1786]"><node index="0" text="Some verbs have a prefix that splits off in a simple sentence and goes to the very end. For example fernsehen (to watch TV): Ich sehe jeden Abend fern. The main verb (sehe) is in position 2 and fern goes to the end." resource-id="" class="android.widget.TextView" package="io.github.samaliyan.trilingo" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,558][986,882]" /><node index="1" text="Common separable prefixes: ab, an, auf, aus, ein, mit, nach, vor, weg, zu, zurück, fern, los. The stress is on the prefix: ÁNrufen." resource-id="" class="android.widget.TextView" package="io.github.samaliyan.trilingo" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,915][986,1103]" /><node index="2" text="When the verb does not split:" resource-id="" class="android.widget.TextView" package="io.github.samaliyan.trilingo" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,1136][986,1188]" /><node index="3" text="• with a modal verb it stays whole at the end: Ich will heute fernsehen." resource-id="" class="android.widget.TextView" package="io.github.samaliyan.trilingo" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,1205][986,1325]" /><node index="4" text="• in a subordinate clause (after weil, dass …) it stays whole at the end: …, weil ich fernsehe." resource-id="" class="android.widget.TextView" package="io.github.samaliyan.trilingo" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,1342][986,1530]" /><node index="5" text="• in the Perfekt, ge goes between prefix and verb: ferngesehen, angerufen, aufgestanden." resource-id="" class="android.widget.TextView" package="io.github.samaliyan.trilingo" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,1547][986,1667]" /><node index="6" text="• zu also goes in between: anzurufen." resource-id="" class="android.widget.TextView" package="io.github.samaliyan.trilingo" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,1684][986,1736]" /></node><node index="3" text="TABLE" resource-id="" class="android.widget.TextView" package="io.github.samaliyan.trilingo" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[44,1786][1036,1894]" /><node index="4" text="" resource-id="" class="android.widget.HorizontalScrollView" package="io.github.samal