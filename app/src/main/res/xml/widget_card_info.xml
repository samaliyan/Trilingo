<?xml version="1.0" encoding="utf-8"?>
<!-- Newer attributes are ignored by older Android versions, which is intended. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_card_description"
    android:initialLayout="@layout/widget_card"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="160dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_card_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="10800000"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
