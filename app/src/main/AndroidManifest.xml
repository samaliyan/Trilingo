<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Translation requests, and checking/downloading updates from GitHub Releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To tell "no internet" apart from "the service did not answer". -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Pronunciation practice: record yourself saying a word (asked for only when you tap Record). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+: lets the app see the phone's text-to-speech engine (for the speaker buttons). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Voice search uses the phone's speech recognition; Scan text uses its camera app. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- The interface is English, so it stays left-to-right even when the phone uses a right-to-left language.
         Persian results are still shown right-to-left (see Ui.bidi). -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        tools:ignore="RtlEnabled">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Select a word in any app → "Trilingo" in the text menu. -->
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Share text → Trilingo. -->
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".GrammarActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".LessonActivity"
            android:exported="false" />

        <activity android:name=".NotebookActivity" android:exported="false" />
        <activity android:name=".ReviewActivity" android:exported="false" />
        <activity android:name=".PracticeActivity" android:exported="false" />
        <activity
            android:name=".CheckActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Share a picture (e.g. a screenshot) → "Scan text": tap its words to translate them. -->
        <activity
            android:name=".ScanActivity"
            android:exported="true"
            android:label="@string/scan_share_label">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name=".PhotoProvider"
            android:authorities="io.github.samaliyan.trilingo.photo"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- ML Kit starts itself when the app starts; Scan text starts it instead, so the app opens faster. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            android:authorities="${applicationId}.mlkitinitprovider"
            tools:node="remove" />

        <receiver
            android:name=".WidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name=".TranslateTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
